# SAMO ZA LOKALNI RAZVOJ (go run bez Dockera). Ne koristi se u deploy-u.
# Pravi .env za VM-ove pravi Ansible: rola app, predlozak ansible/roles/app/templates/env.j2
# (make deploy generise lozinke i salje .env); lozinke su u ansible/.secrets/, a na VM-u .env je 0600.
# Ne uredjivati ga rucno i ne kopirati ovaj fajl na VM.
DSN=invoices:invoices@tcp(localhost:3306)/invoices?parseTime=true
PORT=8081
FRONTEND_ORIGIN=http://localhost:3000
