# Portovi
FRONTEND_PORT=80
BACKEND_PORT=8080
DB_PORT=3306

# Adrese na koje se objavljuju portovi; zadano 127.0.0.1 znaci da port nije
# dostupan s mreze. Na db VM postaviti DB_BIND=10.40.3.2, a na app VM
# BACKEND_BIND=10.40.2.2.
DB_BIND=127.0.0.1
BACKEND_BIND=127.0.0.1

# Baza podataka
DB_NAME=invoices
DB_USER=invoices
DB_PASSWORD=REMOVED
DB_ROOT_PASSWORD=REMOVED
DB_HOST=db

# Nginx reverse proxy
BACKEND_URL=http://backend:8080
