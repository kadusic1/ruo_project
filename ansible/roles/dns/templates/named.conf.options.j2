// Generisano iz Ansiblea (rola dns). Ne uredjivati rucno.
options {
    directory "/var/cache/bind";

    listen-on { {{ dns_ip }}; 127.0.0.1; };
    listen-on-v6 { none; };

    // samo autoritativni odgovori za zonu projekta; VM-ovi nemaju izlaz na
    // internet pa vanjska imena ne trebaju (nema rekurzije ni prosljedjivanja)
    recursion no;
    allow-query { {{ fw_mreza }}; 127.0.0.1; };

    dnssec-validation no;

    allow-transfer { none; };
};
