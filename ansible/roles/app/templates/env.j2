# Generisano iz Ansible role app ({{ app_profile }}), ne uredjivati rucno.
# Imena su ona koja kontejner ocekuje; svaki sloj dobija samo svoje varijable.
{% if app_profile == 'db' %}
MARIADB_DATABASE={{ app_db_name }}
MARIADB_USER={{ app_db_user }}
MARIADB_PASSWORD={{ app_db_password }}
MARIADB_ROOT_PASSWORD={{ app_db_root_password }}
{% elif app_profile == 'app' %}
DSN={{ app_db_user }}:{{ app_db_password }}@tcp({{ app_db_host }}:3306)/{{ app_db_name }}?parseTime=true
FRONTEND_ORIGIN={{ app_frontend_origin }}
{% elif app_profile == 'web' %}
BACKEND_URL={{ app_backend_url }}
{% endif %}
